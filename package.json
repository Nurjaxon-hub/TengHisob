{
  "name": "tenghisob-android",
  "version": "1.0.2",
  "private": true,
  "description": "TengHisob Android ilovasi",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "android:init": "npm run build:web && npx cap add android",
